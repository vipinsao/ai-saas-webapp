# Copy to .env.local (Next.js loads it automatically) and fill in real values.
# Every service below has a free tier that does not ask for a card.

# --- Database (Prisma / PostgreSQL) -----------------------------------------
# Connection string used by prisma/schema.prisma for the Video table.
# Local Postgres: `docker compose up -d db` in this repo, then use the URL below.
# Hosted free option: a Neon project (https://neon.tech) -> "Connection string".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudinary_saas"

# --- Clerk authentication ----------------------------------------------------
# Both keys come from https://dashboard.clerk.com -> your app -> API keys.
# The publishable key is read by the browser bundle; the secret key is server
# only. The production build fails without the publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Cloudinary (video only) -------------------------------------------------
# Only the video upload route and the video thumbnails use Cloudinary; images
# are processed locally by sharp. Values are at https://console.cloudinary.com
# -> Dashboard -> API keys. Leave blank if you only use the image features.
# The cloud name is part of every delivery URL and is safe in the browser
# bundle. The key and secret are server side and must never gain a
# NEXT_PUBLIC_ prefix. If any of the three is missing or blank, the video
# routes answer 503 and name the ones that are missing; the image half is
# unaffected.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Local image storage (optional) ------------------------------------------
# Directory the sharp pipeline writes uploads into, one folder per user.
# Defaults to ./storage/uploads when unset.
IMAGE_STORAGE_DIR=""

# Per-user cap on that directory, in bytes. Defaults to 104857600 (100 MB).
# An upload that would cross it is refused with 507 Insufficient Storage.
# An unparseable or non-positive value falls back to the default rather than
# meaning "unlimited" or "nothing allowed".
IMAGE_STORAGE_QUOTA_BYTES=""
